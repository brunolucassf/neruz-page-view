{
  "name": "neruz-extensions",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev:ext": "pnpm --filter @neruz/page-view dev",
    "dev:landing": "pnpm --filter @neruz/landing dev",
    "build:ext": "pnpm --filter @neruz/page-view build",
    "build:ext:firefox": "pnpm --filter @neruz/page-view build:firefox",
    "build:landing": "pnpm --filter @neruz/landing build",
    "lint": "biome check .",
    "typecheck": "pnpm -r --workspace-concurrency=1 --if-present typecheck",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
