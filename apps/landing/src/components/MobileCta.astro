---
import type { LandingCopy } from '../i18n';

interface Props {
  copy: LandingCopy;
}

const { copy } = Astro.props;
---

<div class="mobile-cta" data-mobile-cta hidden>
  <p class="mobile-cta__label">{copy.cta.mobileInstall}</p>
  <button
    type="button"
    class="btn btn--compact"
    data-copy-link
    data-label-copy={copy.cta.copyLink}
    data-label-share={copy.cta.share}
  >
    {copy.cta.copyLink}
  </button>
  <p class="visually-hidden" role="status" aria-live="polite" data-copy-status data-label-done={copy.cta.linkCopied}></p>
</div>

<style>
  .mobile-cta {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--pv-space-6);
    padding: var(--pv-space-4) var(--pv-gutter) calc(var(--pv-space-4) + env(safe-area-inset-bottom));
    border-top: 1px solid var(--pv-line);
    background: var(--pv-bg-chrome);
    transform: translateY(110%);
    transition: transform var(--pv-dur-exit) var(--pv-ease-out);
  }

  .mobile-cta[hidden] {
    display: none;
  }

  .mobile-cta.is-visible {
    transform: none;
    transition-duration: var(--pv-dur-base);
  }

  .mobile-cta__label {
    color: var(--pv-text-2);
    font-size: var(--pv-fs-small);
    line-height: 1.3;
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-cta {
      transform: none;
      opacity: 0;
      transition: opacity 120ms linear;
    }

    .mobile-cta.is-visible {
      opacity: 1;
    }
  }
</style>
