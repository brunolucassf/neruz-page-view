---
import type { LandingCopy } from '../i18n';
import { STORE_LINKS } from '../i18n';
import StoreButton from './StoreButton.astro';

interface Props {
  copy: LandingCopy;
}

const { copy } = Astro.props;
const scene = copy.sceneFinal;
---

<section class="fin" id="instalar" data-scene-id="instalar" aria-labelledby="fin-title" data-final>
  <div class="scene-track scene-track--always" data-track>
    <div class="fin__stage scene-stage" data-fin-stage>
      <div class="fin__rig" data-fin-rig>
        <div class="fin__cota" data-fin-cota aria-hidden="true">
          <span class="fin__cota-line"></span>
          <span class="fin__cota-value cota-text" data-fin-value>1280 px</span>
        </div>
        <div class="fin__window" data-fin-window>
          <div class="fin__frame">
            <div class="fin__bar">
              <span class="fin__strokes" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="fin__window-title cota-text">{scene.windowTitle}</span>
            </div>
            <div class="fin__body" data-fin-body>
              <svg class="fin__mark" viewBox="16 20 96 92" aria-hidden="true" focusable="false">
                <path d="M24 20H104L112 28V46H100V32H28V88H54V100H24L16 92V28Z"></path>
                <path d="M72 52H104L112 60V104L104 112H72L64 104V60ZM76 64V100H100V64Z" fill-rule="evenodd"></path>
              </svg>
              <p class="scene-copy__index eyebrow">
                <span>{scene.stepLabel}</span>
                <span class="visually-hidden">
                  {copy.ruler.counter.replace('{n}', '8').replace('{total}', '8')}
                </span>
              </p>
              <h2 id="fin-title" class="fin__title">{scene.title}</h2>
              <p class="fin__subtitle">{scene.subtitle}</p>
              <div class="fin__actions" data-final-cta>
                <StoreButton copy={copy} withMeta />
                <a class="text-link" href={STORE_LINKS.github}>{copy.cta.viewCode}</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .fin {
    position: relative;
    background-color: var(--pv-bg-mat);
    background-image:
      linear-gradient(var(--pv-mat-grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--pv-mat-grid) 1px, transparent 1px);
    background-size: 64px 64px;
    background-position: center top;
  }

  .fin .scene-track {
    --scene-track: 100vh;
  }

  @media (min-width: 1024px) {
    .fin .scene-track {
      --scene-track: 150vh;
    }
  }

  .fin__stage {
    display: grid;
    align-content: center;
    padding: var(--pv-space-9) var(--pv-site-inline) 88px;
  }

  @media (min-width: 1024px) {
    .fin__stage {
      padding-block: var(--pv-space-13);
    }
  }

  .fin__rig {
    display: grid;
    gap: var(--pv-space-4);
    justify-items: start;
    width: 100%;
  }

  .fin__cota {
    position: relative;
    display: flex;
    width: var(--fin-width, 100%);
    max-width: 100%;
    align-items: center;
    justify-content: center;
    height: 20px;
  }

  .fin__cota-line {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
    background: var(--pv-line-strong);
  }

  .fin__cota-line::before,
  .fin__cota-line::after {
    content: "";
    position: absolute;
    top: -5px;
    width: 1px;
    height: 11px;
    background: var(--pv-cyan);
  }

  .fin__cota-line::before {
    left: 0;
  }

  .fin__cota-line::after {
    right: 0;
  }

  .fin__cota-value {
    position: relative;
    padding: 0 var(--pv-space-4);
    background: var(--pv-bg-mat);
    color: var(--pv-text);
    font-size: 12px;
  }

  .fin__window {
    --cut: clamp(16px, 2vw, 32px);
    position: relative;
    width: var(--fin-width, 100%);
    max-width: 100%;
    background: var(--pv-line);
    box-shadow: var(--pv-shadow-frame);
    clip-path: polygon(
      var(--cut) 0,
      calc(100% - var(--cut)) 0,
      100% var(--cut),
      100% 100%,
      0 100%,
      0 var(--cut)
    );
    overflow: hidden;
  }

  .fin__frame {
    position: relative;
    display: grid;
    justify-items: start;
    margin: 1px;
    background: var(--pv-bg-chrome);
    clip-path: polygon(
      calc(var(--cut) - 0.7px) 0,
      calc(100% - var(--cut) + 0.7px) 0,
      100% calc(var(--cut) - 0.7px),
      100% 100%,
      0 100%,
      0 calc(var(--cut) - 0.7px)
    );
  }

  .fin__bar {
    display: flex;
    justify-self: stretch;
    width: 100%;
    align-items: center;
    gap: var(--pv-space-5);
    height: 32px;
    padding-inline: var(--pv-space-7);
    border-bottom: 1px solid var(--pv-line);
    background: var(--pv-bg-raised);
  }

  .fin__strokes {
    display: flex;
    gap: 4px;
  }

  .fin__strokes i {
    width: 14px;
    height: 2px;
    background: var(--pv-line-strong);
  }

  .fin__window-title {
    color: var(--pv-text-2);
    font-size: 11px;
  }

  .fin__mark {
    display: none;
  }

  .fin__body {
    position: relative;
    display: grid;
    justify-items: start;
    gap: var(--pv-space-7);
    width: var(--fin-body-width, 100%);
    max-width: none;
    padding: var(--pv-space-8) var(--pv-space-7) var(--pv-space-9);
  }

  .fin__title {
    max-width: 16ch;
    margin: 0;
    font-family: var(--pv-fs-h2-ff);
    font-size: clamp(1.875rem, 1.2rem + 3.2vw, 4.5rem);
    font-weight: var(--pv-fs-h2-fw);
    line-height: var(--pv-fs-h2-lh);
    letter-spacing: var(--pv-fs-h2-ls);
    text-wrap: balance;
  }

  .fin__subtitle {
    max-width: 52ch;
    color: var(--pv-text-2);
    font-size: var(--pv-fs-lead);
    line-height: var(--pv-fs-lead-lh);
  }

  .fin__actions {
    display: grid;
    gap: var(--pv-space-6);
    justify-items: start;
  }

  @media (min-width: 768px) {
    .fin__body {
      padding: var(--pv-space-11) var(--pv-space-8) var(--pv-space-12);
    }
  }

  @media (min-width: 1024px) {
    .fin__mark {
      position: absolute;
      top: 50%;
      right: var(--pv-space-12);
      display: block;
      width: clamp(140px, 15vw, 220px);
      height: auto;
      fill: none;
      stroke: var(--pv-line);
      stroke-width: 0.8;
      stroke-linejoin: miter;
      transform: translateY(-50%);
    }

    .fin__body {
      padding: var(--pv-space-13) var(--pv-space-13) var(--pv-space-14);
    }

    .fin__actions {
      grid-auto-flow: column;
      align-items: start;
      gap: var(--pv-space-10);
    }
  }
</style>
