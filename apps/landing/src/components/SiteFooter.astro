---
import type { LandingCopy } from '../i18n';
import { BROWSER_NAMES, BROWSER_ORDER, FONTE_DEV_URL, IS_STORE_LIVE, STORE_LINKS } from '../i18n';
import LanguageMenu from './LanguageMenu.astro';

interface Props {
  copy: LandingCopy;
  kind?: 'home' | 'privacy';
}

const { copy, kind = 'home' } = Astro.props;
const { footer } = copy;
const projectLinks = [
  { href: STORE_LINKS.github, label: footer.project.github },
  { href: STORE_LINKS.license, label: footer.project.license },
  { href: STORE_LINKS.privacy, label: footer.privacy },
  { href: copy.privacyPath, label: copy.consent.policy },
  { href: STORE_LINKS.issues, label: footer.project.issue },
];
---

<footer class="site-footer">
  <div class="shell">
    <nav class="site-footer__columns" aria-label={footer.navLabel}>
      <section class="site-footer__column" aria-labelledby="footer-product">
        <h2 id="footer-product" class="site-footer__title">{footer.product.title}</h2>
        <p class="site-footer__hint">{footer.product.installTitle}</p>
        {
          IS_STORE_LIVE ? (
            <ul class="site-footer__list">
              {BROWSER_ORDER.map((browser) => (
                <li>
                  <a href={STORE_LINKS[browser]}>{BROWSER_NAMES[browser]}</a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="site-footer__text">{footer.product.comingSoon}</p>
          )
        }
      </section>

      <section class="site-footer__column" aria-labelledby="footer-project">
        <h2 id="footer-project" class="site-footer__title">{footer.project.title}</h2>
        <ul class="site-footer__list">
          {
            projectLinks.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
          <li><button type="button" class="site-footer__consent" data-consent-open>{copy.consent.preferences}</button></li>
        </ul>
      </section>


      <section class="site-footer__column site-footer__studio" aria-labelledby="footer-studio">
        <h2 id="footer-studio" class="site-footer__title">
          <a class="site-footer__studio-logo" href={FONTE_DEV_URL} target="_blank" rel="noopener">
            <img
              src="/fonte-dev_horizontal_fundo-escuro.svg"
              width="114"
              height="30"
              alt={footer.studio.title}
              loading="lazy"
              decoding="async"
            />
            <span class="visually-hidden">{copy.common.newTab}</span>
          </a>
        </h2>
        <p class="site-footer__text">{footer.studio.text}</p>
        <a
          class="btn btn--ghost site-footer__studio-cta"
          href={FONTE_DEV_URL}
          target="_blank"
          rel="noopener"
          aria-label={footer.studio.ctaLabel}
          data-wire
        >
          <span>{footer.studio.cta}</span>
          <svg class="btn__arrow" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
            <path d="M6 14 14 6M7.5 6H14v6.5"></path>
          </svg>
        </a>
      </section>
    </nav>

    <div class="site-footer__base">
      <img
        class="site-footer__logo"
        src="/logo-horizontal.svg"
        width="180"
        height="48"
        alt="Neruz Page View"
        loading="lazy"
        decoding="async"
      />
      <LanguageMenu copy={copy} opensUp kind={kind} />
      <p class="site-footer__credit">
        <a href={FONTE_DEV_URL} target="_blank" rel="noopener">
          {footer.credit}
          <span class="visually-hidden">{copy.common.newTab}</span>
        </a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: 2;
    padding-block: var(--pv-space-15) calc(var(--pv-space-14) + 40px);
    border-top: 1px solid var(--pv-line-soft);
    background: var(--pv-bg-mat);
    color: var(--pv-text-2);
    font-size: var(--pv-fs-small);
    line-height: var(--pv-fs-small-lh);
  }

  .site-footer__columns {
    display: grid;
    gap: var(--pv-space-11);
  }

  .site-footer__column {
    display: grid;
    align-content: start;
    gap: var(--pv-space-5);
  }

  .site-footer__title {
    display: flex;
    align-items: center;
    gap: var(--pv-space-4);
    color: var(--pv-text);
    font-family: var(--pv-fs-eyebrow-ff);
    font-size: var(--pv-fs-eyebrow);
    font-weight: var(--pv-fs-eyebrow-fw);
    letter-spacing: var(--pv-fs-eyebrow-ls);
    line-height: var(--pv-fs-eyebrow-lh);
    text-transform: uppercase;
  }

  .site-footer__title::before {
    content: "";
    width: 6px;
    height: 6px;
    background: var(--pv-line-strong);
    transform: rotate(45deg);
  }

  .site-footer__studio .site-footer__title::before {
    content: none;
  }

  .site-footer__studio-logo {
    display: inline-flex;
    margin-top: -4px;
  }

  .site-footer__studio-logo img {
    width: auto;
    height: 30px;
  }

  .site-footer__hint {
    color: var(--pv-text-3);
  }

  .site-footer__text {
    max-width: 38ch;
    color: var(--pv-text-2);
    font-size: var(--pv-fs-body);
    line-height: var(--pv-fs-body-lh);
  }

  .site-footer__list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__consent {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--pv-text-2);
    font-size: var(--pv-fs-body);
    text-decoration: underline;
    text-underline-offset: 4px;
    cursor: pointer;
  }

  .site-footer__list a,
  .site-footer__credit a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    color: var(--pv-text-2);
    font-size: var(--pv-fs-body);
    text-decoration: none;
    transition: color var(--pv-dur-fast) var(--pv-ease-hover);
  }

  .site-footer__studio-cta {
    justify-self: start;
    margin-top: var(--pv-space-4);
  }

  .site-footer__base {
    display: grid;
    justify-items: start;
    gap: var(--pv-space-8);
    margin-top: var(--pv-space-15);
    padding-top: var(--pv-space-10);
    border-top: 1px solid var(--pv-line-soft);
  }

  .site-footer__logo {
    width: 180px;
    height: auto;
    margin-left: -6px;
  }

  .site-footer__base :global(.lang-menu__toggle) {
    border-color: var(--pv-line);
  }

  .site-footer__credit a {
    color: var(--pv-text);
    text-decoration: underline;
    text-decoration-color: var(--pv-line-strong);
    text-underline-offset: 6px;
  }

  @media (hover: hover) and (pointer: fine) {
    .site-footer__list a:hover {
      color: var(--pv-text);
    }

    .site-footer__credit a:hover {
      text-decoration-color: var(--pv-accent);
    }
  }

  @media (min-width: 768px) {
    .site-footer__columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--pv-space-12);
    }

    .site-footer__base {
      grid-template-columns: auto auto 1fr;
      align-items: center;
      column-gap: var(--pv-space-9);
    }

    .site-footer__credit {
      justify-self: end;
    }
  }

  @media (min-width: 1024px) {
    .site-footer {
      padding-block: var(--pv-space-16) var(--pv-space-13);
    }

    .site-footer__columns {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1.6fr);
      column-gap: var(--pv-space-12);
    }
  }
</style>
