---
import type { LandingCopy } from '../i18n';
import { FONTE_DEV_URL, STORE_LINKS } from '../i18n';
import LanguageMenu from './LanguageMenu.astro';
import StoreButton from './StoreButton.astro';

interface Props {
  copy: LandingCopy;
}

const { copy } = Astro.props;
---

<header class="site-header">
  <div class="shell site-header__row">
    <div class="site-header__identity">
      <a class="site-header__brand" href={copy.path} aria-label="Neruz Page View">
        <img src="/logo-horizontal.svg" width="180" height="48" alt="" fetchpriority="high" />
      </a>
      <a
        class="site-header__signature"
        href={FONTE_DEV_URL}
        target="_blank"
        rel="noopener"
        aria-label={copy.header.signatureLabel}
      >
        <img
          class="site-header__signature-mark"
          src="/fonte-dev_icone_fundo-escuro.svg"
          width="18"
          height="16"
          alt=""
        />
        <span>{copy.header.signature}</span>
      </a>
    </div>
    <div class="site-header__actions">
      <LanguageMenu copy={copy} />
      <a class="site-header__github" href={STORE_LINKS.github}>{copy.github}</a>
      <StoreButton copy={copy} compact />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 20;
  }

  .site-header__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--pv-space-6);
    min-height: 80px;
    padding-block: var(--pv-space-5);
  }

  .site-header__identity {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
  }

  .site-header__brand {
    display: inline-flex;
    flex: none;
    margin-left: -6px;
  }

  .site-header__brand img {
    width: 180px;
    height: auto;
  }

  .site-header__signature {
    display: inline-flex;
    align-items: center;
    gap: var(--pv-space-3);
    min-height: 24px;
    margin-top: -6px;
    margin-left: 52px;
    color: var(--pv-text-3);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: color var(--pv-dur-fast) var(--pv-ease-hover);
  }

  .site-header__signature-mark {
    flex: none;
    width: 18px;
    height: 16px;
    opacity: 0.85;
    transition: opacity var(--pv-dur-fast) var(--pv-ease-hover);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--pv-space-4);
  }

  .site-header__github {
    display: none;
    align-items: center;
    min-height: 44px;
    padding-inline: var(--pv-space-4);
    color: var(--pv-text-2);
    font-size: var(--pv-fs-small);
    font-weight: 600;
    text-decoration: none;
    transition: color var(--pv-dur-fast) var(--pv-ease-hover);
  }

  .site-header__actions :global(.store-cta) {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .site-header__github:hover,
    .site-header__signature:hover {
      color: var(--pv-text);
    }

    .site-header__signature:hover .site-header__signature-mark {
      opacity: 1;
    }
  }

  @media (min-width: 480px) {
    .site-header__github {
      display: inline-flex;
    }
  }

  @media (min-width: 768px) {
    .site-header__row {
      min-height: 112px;
      padding-block: var(--pv-space-8);
    }

    .site-header__identity {
      flex-direction: row;
      align-items: center;
      gap: var(--pv-space-6);
    }

    .site-header__signature {
      margin: 0;
      padding-left: var(--pv-space-6);
      border-left: 1px solid var(--pv-line);
      min-height: 28px;
      font-size: var(--pv-fs-small);
    }

    .site-header__actions {
      gap: var(--pv-space-8);
    }
  }

  @media (min-width: 1024px) {
    .site-header__actions :global(.store-cta) {
      display: flex;
    }

    .site-header__actions :global(.store-cta__meta) {
      display: none;
    }
  }

</style>
