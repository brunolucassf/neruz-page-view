---
import type { LandingCopy } from '../i18n';
import { STORE_LINKS } from '../i18n';
import Base from '../layouts/Base.astro';
import SiteFooter from './SiteFooter.astro';

interface Props {
  copy: LandingCopy;
}

const { copy } = Astro.props;
const page = copy.sitePrivacy;
---

<Base copy={copy} kind="privacy" title={page.title} description={page.description}>
  <header class="legal-header">
    <div class="shell">
      <a class="legal-header__brand" href={copy.path} aria-label="Neruz Page View">
        <img src="/logo-horizontal.svg" width="180" height="48" alt="" />
      </a>
    </div>
  </header>
  <main id="conteudo" tabindex="-1" class="legal">
    <h1 class="legal__title">{page.heading}</h1>
    <p class="legal__updated">{page.updated}</p>
    {
      page.blocks.map((block) => (
        <section class="legal__block">
          <h2>{block.title}</h2>
          {block.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </section>
      ))
    }
    <p class="legal__links">
      <a class="text-link" href={STORE_LINKS.privacy}>{page.extension}</a>
    </p>
    <p class="legal__links"><a class="text-link" href={copy.path}>{page.back}</a></p>
  </main>
  <SiteFooter copy={copy} kind="privacy" />
</Base>

<script>
  import '../scripts/legal';
</script>

<style>
  main:focus {
    outline: none;
  }

  .legal-header {
    padding-block: var(--pv-space-6);
  }

  .legal-header__brand {
    display: inline-flex;
  }

  .legal {
    width: min(100% - 2 * var(--pv-space-6), 760px);
    margin-inline: auto;
    padding-block: var(--pv-space-10) var(--pv-space-13);
  }

  .legal__title {
    font-family: var(--pv-font-display);
    font-size: clamp(2rem, 1rem + 3vw, 3.5rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.05;
  }

  .legal__updated {
    margin-top: var(--pv-space-4);
    color: var(--pv-text-3);
    font-size: var(--pv-fs-small);
  }

  .legal__block {
    margin-top: var(--pv-space-9);
    padding-top: var(--pv-space-6);
    border-top: 1px solid var(--pv-line-soft);
  }

  .legal__block h2 {
    margin-bottom: var(--pv-space-4);
    font-family: var(--pv-font-display);
    font-size: 1.25rem;
    font-weight: 600;
  }

  .legal__block p {
    max-width: 68ch;
    color: var(--pv-text-2);
    line-height: 1.65;
  }

  .legal__links {
    margin-top: var(--pv-space-7);
  }
</style>
