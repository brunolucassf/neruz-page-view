---
import type { LandingCopy } from '../i18n';
import { STORE_LINKS } from '../i18n';

interface Props {
  copy: LandingCopy;
}

const { copy } = Astro.props;
const scene = copy.sceneLocal;
const symbolWindow = 'M24 20H104L112 28V46H100V32H28V88H54V100H24L16 92V28Z';
const symbolViewport = 'M72 52H104L112 60V104L104 112H72L64 104V60ZM76 64V100H100V64Z';
---

<section
  class="loc"
  id="tudo-no-computador"
  data-scene-id="tudo-no-computador"
  aria-labelledby="loc-title"
  data-local
  data-forno={JSON.stringify(copy.forno)}
>
  <div class="scene-track scene-track--wide" data-track>
    <div class="loc__stage scene-stage" data-loc-stage>
      <div class="loc__light" data-loc-light aria-hidden="true"></div>
      <div class="loc__layout">
        <div class="loc__text" data-loc-text>
          <p class="scene-copy__index eyebrow">
            <span>{scene.stepLabel}</span>
            <span class="visually-hidden">
              {copy.ruler.counter.replace('{n}', '6').replace('{total}', '7')}
            </span>
          </p>
          <h2 id="loc-title" class="scene-copy__title loc__title">{scene.title}</h2>
          <p class="scene-copy__subtitle loc__subtitle">{scene.subtitle}</p>
          <p class="loc__links">
            <a class="text-link" href={STORE_LINKS.privacy}>{scene.privacyLink}</a>
            <a class="text-link" href={STORE_LINKS.permissions}>{scene.codeLink}</a>
          </p>
        </div>

        <div class="loc__laptop" role="img" aria-label={scene.laptopLabel} data-loc-laptop>
          <svg class="loc__outline" aria-hidden="true" focusable="false" data-loc-outline>
            <path pathLength="1" data-loc-line="left"></path>
            <path pathLength="1" data-loc-line="right"></path>
            <path pathLength="1" data-loc-line="base"></path>
          </svg>
          <div class="loc__objects" data-loc-objects>
            <div class="loc__object loc__object--window" data-loc-object>
              <canvas width="320" height="200" data-loc-canvas="window"></canvas>
            </div>
            <div class="loc__object loc__object--phone" data-loc-object>
              <canvas width="120" height="244" data-loc-canvas="phone"></canvas>
            </div>
            <div class="loc__object loc__object--strip" data-loc-object>
              <canvas width="80" height="340" data-loc-canvas="strip"></canvas>
            </div>
            <svg class="loc__object loc__object--symbol" viewBox="16 20 96 92" data-loc-object focusable="false">
              <path d={symbolWindow}></path>
              <path d={symbolViewport} fill-rule="evenodd"></path>
            </svg>
          </div>
        </div>

        <ul class="loc__cards" data-loc-cards>
          {
            scene.cards.map((card, index) => (
              <li class="loc__card" data-loc-card>
                <button
                  type="button"
                  class="loc__card-toggle"
                  aria-expanded="false"
                  aria-controls={`loc-why-${index}`}
                  data-loc-toggle
                >
                  <span class="loc__perm cota-text">
                    <i aria-hidden="true" />
                    <span>{card.permission}</span>
                    <i aria-hidden="true" />
                  </span>
                  <span class="loc__card-title">{card.title}</span>
                </button>
                <div class="loc__why" id={`loc-why-${index}`}>
                  <p class="loc__what">{card.what}</p>
                  <p class="loc__when cota-text">
                    <span>{scene.whenLabel}</span>
                    {card.when}
                  </p>
                </div>
              </li>
            ))
          }
          <li class="loc__card-note">
            <p class="scene-copy__note loc__note">{scene.note}</p>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .loc {
    --lt-bg: #f4f8fc;
    --lt-ink: #0e1520;
    --lt-ink-2: #3b4b5e;
    --lt-line: #c6d3e0;
    --lt-card: #ffffff;
    position: relative;
    background: var(--pv-bg-mat);
    color: var(--pv-text);
  }

  .loc .scene-track {
    --scene-track: 220vh;
  }

  .loc__stage {
    position: relative;
    padding: var(--pv-space-13) var(--pv-site-inline) var(--pv-space-13);
  }

  .loc__light {
    position: absolute;
    inset: 0;
    background: var(--lt-bg);
    background-image:
      linear-gradient(rgb(14 21 32 / 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgb(14 21 32 / 0.05) 1px, transparent 1px);
    background-size: 64px 64px;
    background-position: center top;
  }

  .loc__layout {
    --pv-text: var(--lt-ink);
    --pv-text-2: var(--lt-ink-2);
    --pv-accent: #007d8a;
    --pv-line-strong: #8296ac;
    position: relative;
    display: grid;
    gap: var(--pv-space-10);
    color: var(--lt-ink);
  }

  .loc__title {
    max-width: 14ch;
    font-size: clamp(1.75rem, 1.15rem + 2.2vw, 3.5rem);
  }

  .loc__card-note {
    display: grid;
    align-content: center;
    padding: var(--pv-space-5) var(--pv-space-4);
  }

  .loc__note {
    max-width: 48ch;
  }

  .loc__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--pv-space-2) var(--pv-space-8);
    margin-top: var(--pv-space-6);
  }

  .loc__laptop {
    position: relative;
    width: min(100%, 520px);
    aspect-ratio: 16 / 10.5;
  }

  .loc__outline {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
    stroke: var(--lt-ink);
    stroke-width: 2;
    stroke-linejoin: miter;
  }

  .loc__outline path {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  .loc__objects {
    position: absolute;
    inset: 9% 9% 21%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6%;
    transform-origin: 50% 50%;
  }

  .loc__object {
    display: block;
    flex: none;
    height: auto;
    box-shadow: 0 10px 24px -12px rgb(14 21 32 / 0.5);
  }

  .loc__object canvas {
    width: 100%;
    height: auto;
    background: var(--demo-cream);
  }

  .loc__object--window {
    --cut: 8px;
    width: 38%;
    clip-path: polygon(
      var(--cut) 0,
      calc(100% - var(--cut)) 0,
      100% var(--cut),
      100% 100%,
      0 100%,
      0 var(--cut)
    );
  }

  .loc__object--phone {
    --cut: 6px;
    width: 15%;
    clip-path: polygon(
      var(--cut) 0,
      calc(100% - var(--cut)) 0,
      100% var(--cut),
      100% calc(100% - var(--cut)),
      calc(100% - var(--cut)) 100%,
      var(--cut) 100%,
      0 calc(100% - var(--cut)),
      0 var(--cut)
    );
  }

  .loc__object--strip {
    --cut: 5px;
    width: 10%;
    clip-path: polygon(
      var(--cut) 0,
      100% 0,
      100% 100%,
      0 100%,
      0 var(--cut)
    );
  }

  .loc__object--symbol {
    width: 14%;
    box-shadow: none;
    fill: var(--lt-ink);
  }

  .loc__cards {
    display: grid;
    gap: var(--pv-space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .loc__card {
    --cut: var(--pv-cut-md);
    position: relative;
    background: var(--lt-card);
    box-shadow: inset 0 0 0 1px var(--lt-line);
    clip-path: polygon(
      0 0,
      calc(100% - var(--cut)) 0,
      100% var(--cut),
      100% 100%,
      0 100%
    );
  }

  .loc__card-toggle {
    display: grid;
    gap: var(--pv-space-4);
    width: 100%;
    min-height: 104px;
    padding: var(--pv-space-5) var(--pv-space-6);
    border: 0;
    background: transparent;
    color: var(--lt-ink);
    text-align: left;
    cursor: default;
    transition: transform var(--pv-dur-press) var(--pv-ease-out);
  }

  .loc__card-toggle:active {
    transform: scale(0.97);
  }

  .loc__card-toggle:focus-visible {
    outline: 2px solid #007d8a;
    outline-offset: -4px;
  }

  .loc__perm {
    display: flex;
    align-items: center;
    gap: var(--pv-space-4);
    color: #006b76;
    font-size: 11px;
    overflow-wrap: anywhere;
  }

  .loc__perm i {
    display: block;
    flex: none;
    width: 1px;
    height: 10px;
    background: #006b76;
  }

  .loc__perm i:last-child {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, #006b76 0 100%) center / 100% 1px no-repeat;
  }

  .loc__perm i:first-child {
    width: 16px;
    height: 1px;
    background: #006b76;
  }

  .loc__card-title {
    font-family: var(--pv-font-display);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .loc__why {
    display: grid;
    gap: var(--pv-space-4);
    padding: var(--pv-space-5) var(--pv-space-6) var(--pv-space-6);
    border-top: 1px solid var(--lt-line);
    color: var(--lt-ink-2);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .loc__what {
    color: var(--lt-ink);
  }

  .loc__when {
    display: grid;
    gap: 2px;
    color: #006b76;
    font-size: 11px;
    line-height: 1.4;
  }

  .loc__when span {
    color: var(--lt-ink-2);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (min-width: 768px) {
    .loc__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .loc__layout {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--pv-space-9);
      align-items: center;
      height: 100%;
    }

    .loc__text {
      grid-column: 1 / span 5;
      grid-row: 1;
    }

    .loc__laptop {
      grid-column: 1 / span 5;
      grid-row: 2;
      width: 100%;
    }

    .loc__layout {
      grid-template-rows: auto auto;
      align-content: center;
      row-gap: var(--pv-space-9);
    }

    .loc__cards {
      grid-column: 6 / span 7;
      grid-row: 1 / span 2;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-self: center;
    }

  }

  @media (min-width: 1024px) and (hover: hover) and (pointer: fine) {
    :global(.is-motion) .loc__card {
      clip-path: none;
    }

    :global(.is-motion) .loc__card-toggle {
      cursor: pointer;
    }

    :global(.is-motion) .loc__why {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      z-index: 3;
      display: grid;
      min-height: 100%;
      align-content: center;
      border-top: 0;
      background: var(--lt-ink);
      color: #c3d0dd;
      clip-path: inset(0 100% 0 0);
      pointer-events: none;
      transition: clip-path 260ms var(--pv-ease-cut);
    }

    :global(.is-motion) .loc__what {
      color: #f4f8fc;
    }

    :global(.is-motion) .loc__when {
      color: #5ceeff;
    }

    :global(.is-motion) .loc__when span {
      color: #a6b5c5;
    }

    :global(.is-motion) .loc__card:hover,
    :global(.is-motion) .loc__card:focus-within,
    :global(.is-motion) .loc__card.is-open {
      z-index: 4;
    }

    :global(.is-motion) .loc__card:hover .loc__why,
    :global(.is-motion) .loc__card:focus-within .loc__why,
    :global(.is-motion) .loc__card.is-open .loc__why {
      clip-path: inset(0 0 0 0);
    }
  }

  @media (max-width: 1023px), (hover: none), (pointer: coarse) {
    :global(.is-motion) .loc__why {
      display: grid;
    }
  }

  @media (max-width: 1023px) {
    .loc__stage {
      padding-block: var(--pv-space-12);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .loc__card-toggle:active {
      transform: none;
    }
  }
</style>
