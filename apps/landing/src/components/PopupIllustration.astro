---
import type { LandingCopy } from '../i18n';

interface Props {
  copy: LandingCopy;
}

const { copy } = Astro.props;
const popup = copy.popup;

function wrapWords(text: string, maxChars: number): string[] {
  const lines: string[] = [];
  let current = '';
  for (const word of text.split(' ')) {
    const candidate = current ? `${current} ${word}` : word;
    if (candidate.length > maxChars && current) {
      lines.push(current);
      current = word;
    } else {
      current = candidate;
    }
  }
  if (current) lines.push(current);
  return lines;
}

const quickHintLines = wrapWords(popup.quickShotHint, 46);
const studioHintLines = wrapWords(popup.openStudioHint, 48);
const symbolWindow = 'M24 20H104L112 28V46H100V32H28V88H54V100H24L16 92V28Z';
const symbolViewport = 'M72 52H104L112 60V104L104 112H72L64 104V60ZM76 64V100H100V64Z';
const popupTop = 52;
---

<svg
  class="popup-art"
  viewBox="0 0 360 404"
  width="360"
  height="404"
  focusable="false"
  aria-hidden="true"
>
  <defs>
    <clipPath id="popup-url-clip"><rect x="16" y={popupTop + 236} width="244" height="40"></rect></clipPath>
  </defs>
  <g data-popup-toolbar>
    <rect x="0.5" y="0.5" width="359" height="39" fill="#0E1520" stroke="#304256"></rect>
    <rect x="14" y="14" width="140" height="12" rx="2" fill="#141D29"></rect>
    <rect x="262" y="12" width="16" height="16" rx="2" fill="none" stroke="#304256"></rect>
    <rect x="290" y="12" width="16" height="16" rx="2" fill="none" stroke="#304256"></rect>
    <g data-popup-icon>
      <rect x="318" y="6" width="28" height="28" rx="4" fill="#1B2635" opacity="0" data-popup-icon-hover></rect>
      <g transform="translate(320 8) scale(0.1875)">
        <path d="M24 0H104L128 24V104L104 128H24L0 104V24Z" fill="#080D14" stroke="#304256" stroke-width="5"></path>
        <g transform="translate(5 4) scale(.92)" fill="#00E5FF" fill-rule="evenodd">
          <path d={symbolWindow}></path>
          <path d={symbolViewport}></path>
        </g>
      </g>
    </g>
  </g>
  <g data-popup-panel>
    <rect x="0.5" y={popupTop + 0.5} width="359" height="351" fill="#0E1520" stroke="#304256"></rect>
    <g transform={`translate(14 ${popupTop + 13}) scale(0.172)`} fill="#00E5FF" fill-rule="evenodd">
      <path d={symbolWindow}></path>
      <path d={symbolViewport}></path>
    </g>
    <text x="42" y={popupTop + 30} fill="#F4F8FC" font-family="Sora, system-ui, sans-serif" font-weight="600" font-size="14">{popup.title}</text>
    <path d={`M0 ${popupTop + 48}H360`} stroke="#1F2B3A"></path>
    <g data-popup-quick style="transform-box: fill-box; transform-origin: center">
      <path
        d={`M24 ${popupTop + 64}H336L344 ${popupTop + 72}V${popupTop + 144}L336 ${popupTop + 152}H24L16 ${popupTop + 144}V${popupTop + 72}Z`}
        fill="#00E5FF"
        data-popup-quick-fill
      ></path>
      <text x="32" y={popupTop + 94} fill="#080D14" font-family="Sora, system-ui, sans-serif" font-weight="600" font-size="17">{popup.quickShotLabel}</text>
      {
        quickHintLines.map((line, index) => (
          <text x="32" y={popupTop + 116 + index * 16} fill="#080D14" fill-opacity="0.78" font-family="Inter, system-ui, sans-serif" font-size="12">
            {line}
          </text>
        ))
      }
    </g>
    <rect x="16.5" y={popupTop + 164.5} width="327" height="59" rx="4" fill="#141D29" stroke="#64798F"></rect>
    <text x="32" y={popupTop + 189} fill="#F4F8FC" font-family="Inter, system-ui, sans-serif" font-weight="600" font-size="14">{popup.openStudioLabel}</text>
    {
      studioHintLines.map((line, index) => (
        <text x="32" y={popupTop + 208 + index * 16} fill="#A6B5C5" font-family="Inter, system-ui, sans-serif" font-size="12">
          {line}
        </text>
      ))
    }
    <rect x="16.5" y={popupTop + 236.5} width="251" height="39" rx="4" fill="none" stroke="#64798F"></rect>
    <text x="28" y={popupTop + 260} fill="#8296AC" font-family="Inter, system-ui, sans-serif" font-size="12" clip-path="url(#popup-url-clip)">{popup.urlPlaceholder}</text>
    <rect x="276" y={popupTop + 236} width="68" height="40" rx="4" fill="#1B2635"></rect>
    <text x="310" y={popupTop + 260} text-anchor="middle" fill="#F4F8FC" font-family="Inter, system-ui, sans-serif" font-weight="600" font-size="13">{popup.urlButton}</text>
    <text x="16" y={popupTop + 304} fill="#8296AC" font-family="Inter, system-ui, sans-serif" font-weight="500" font-size="11">{popup.deviceLabel}</text>
    <text x="16" y={popupTop + 324} fill="#F4F8FC" font-family="Inter, system-ui, sans-serif" font-weight="500" font-size="13" style="font-feature-settings: 'tnum' 1">390 × 844</text>
    <text x="344" y={popupTop + 324} text-anchor="end" fill="#00E5FF" font-family="Inter, system-ui, sans-serif" font-weight="600" font-size="13">{popup.deviceChange}</text>
  </g>
  <g data-popup-cursor>
    <path d="M0 0V17L4.5 12.8L7.6 19.6L10.4 18.4L7.4 11.8H13.4Z" fill="#F4F8FC" stroke="#080D14" stroke-width="1.2" stroke-linejoin="round"></path>
  </g>
</svg>
