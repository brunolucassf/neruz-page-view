---
import '@neruz/ui/tokens.css';
import '../styles/global.css';
import type { LandingCopy } from '../i18n';
import { DICTIONARIES } from '../i18n';
import ConsentBanner from '../components/ConsentBanner.astro';

interface Props {
  copy: LandingCopy;
  kind?: 'home' | 'privacy';
  title?: string;
  description?: string;
}

const { copy, kind = 'home' } = Astro.props;
const title = Astro.props.title ?? copy.meta.title;
const description = Astro.props.description ?? copy.meta.description;
const ogDescription = kind === 'home' ? copy.meta.ogDescription : description;
const alternates = Object.values(DICTIONARIES);
---

<!doctype html>
<html lang={copy.htmlLang} data-locale={copy.locale} data-product="page-view">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#080D14" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content="website" />
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.htmlLang} href={kind === 'home' ? alt.path : alt.privacyPath} />)}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="preload" href="/fonts/Sora-600.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Sora-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Inter-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Inter-500.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const prefersReducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
        const connection = navigator.connection;
        const isSaveData = Boolean(connection && connection.saveData);
        root.classList.add('has-js');
        if (prefersReducedMotion) {
          root.classList.add('is-static');
          return;
        }
        root.classList.add('is-motion');
        if (isSaveData) root.classList.add('is-lite');
        let hasSeenIntro = false;
        try {
          hasSeenIntro = sessionStorage.getItem('pv-intro') === '1';
        } catch {}
        if (!hasSeenIntro) root.classList.add('is-intro');
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#conteudo">{copy.skipLink}</a>
    <ConsentBanner copy={copy} />
    <slot />
    <script>
      import '../scripts/consent';
    </script>
  </body>
</html>
